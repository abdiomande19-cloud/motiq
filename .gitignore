# Dépendances
node_modules/
.venv/
__pycache__/
*.pyc

# Secrets — LE POINT CRITIQUE (§12 : aucune clé exposée)
.env
.env.*
!.env.example
*.pem
*.key

# Sorties de build
dist/
build/
.next/
out/

# Médias rendus et journaux
*.mp4
*.webm
logs/
*.log

# Donnees locales de developpement (implementation locale, decision D2)
.donnees/
next-env.d.ts
*.tsbuildinfo

# Système
.DS_Store
Thumbs.db
desktop.ini

# Sauvegardes locales (créées par le garde-fou avant modification)
*.bak.*

# artefacts de livraison (ne pas versionner)
*.bundle
*.zip

# Les liens signes contiennent un jeton d acces : jamais dans le depot.
LIEN-VIDEO.txt
*.log
