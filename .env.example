# =============================================================================
# MOTIQ — variables d'environnement de l'APPLICATION (serveur uniquement)
# -----------------------------------------------------------------------------
# MODE D'EMPLOI
#   1. Copiez ce fichier en « .env » dans le même dossier :
#        copie de  .env.example  ->  .env
#   2. Collez vos valeurs APRÈS le signe =, sur les lignes indiquées.
#   3. Enregistrez. Ne transmettez JAMAIS ce fichier à un agent, ne le collez
#      jamais dans une conversation, ne le committez jamais.
#
# Ce fichier ne doit jamais être exposé au navigateur (§12 du cahier des
# charges : aucune clé secrète côté client). Les seules valeurs visibles côté
# client sont celles marquées [PUBLIC].
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — authentification, base PostgreSQL, stockage
# -----------------------------------------------------------------------------
# Où les trouver : tableau de bord Supabase > Project Settings > API
SUPABASE_URL=                 # [PUBLIC] ex. https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=            # [PUBLIC] clé « anon » — visible côté client, protégée par les règles RLS
SUPABASE_SERVICE_ROLE_KEY=    # [SECRET] contourne TOUTES les règles RLS — serveur uniquement, jamais côté client
SUPABASE_ACCESS_TOKEN=        # [SECRET] jeton personnel (Account > Access Tokens) — sert à lier le projet par CLI
SUPABASE_PROJECT_REF=         # [PUBLIC] référence du projet, ex. abcdefghijklmnop

# -----------------------------------------------------------------------------
# GITHUB — dépôt, commits, revues
# -----------------------------------------------------------------------------
# À créer : GitHub > Settings > Developer settings > Personal access tokens >
#           Fine-grained tokens
#   Portée : UN SEUL dépôt (Selected repositories)
#   Droits : Contents = Read and write · Metadata = Read · Pull requests = Read and write
#   Durée  : 90 jours (à renouveler)
GITHUB_TOKEN=                 # [SECRET] jeton à portée limitée — un seul dépôt
GITHUB_REPO=                  # [PUBLIC] ex. votre-compte/motiq
GIT_AUTHOR_NAME=              # [PUBLIC] nom affiché sur les commits
GIT_AUTHOR_EMAIL=             # [PUBLIC] e-mail des commits (peut être un e-mail GitHub « noreply »)

# -----------------------------------------------------------------------------
# VERCEL — hébergement de la PWA
# -----------------------------------------------------------------------------
# À créer : Vercel > Account Settings > Tokens (restreindre au projet si possible)
VERCEL_TOKEN=                 # [SECRET] jeton d'API
VERCEL_PROJECT=               # [PUBLIC] nom du projet Vercel

# -----------------------------------------------------------------------------
# STRIPE — abonnements et webhooks
# -----------------------------------------------------------------------------
# PAIEMENT — Paystack (Côte d'Ivoire)
#
# POURQUOI PAYSTACK ET PAS STRIPE : en Côte d'Ivoire, Stripe n'a pas de compte
# direct — la page officielle stripe.com/global y renvoie vers Paystack, qui est
# une société Stripe. Paystack encaisse en FCFA et accepte le Mobile Money
# (Orange Money, MTN Momo, Wave), ce que Stripe classique ne fait pas.
#
# COMMENCEZ PAR LES CLÉS DE TEST (pk_test_ / sk_test_). On ne passe en
# production qu'après validation humaine de la Phase 5.
PAYSTACK_PUBLIC_KEY=          # [PUBLIC] pk_test_… d'abord
PAYSTACK_SECRET_KEY=          # [SECRET] sk_test_… d'abord
PAYSTACK_WEBHOOK_SECRET=      # [SECRET] créé en déclarant l'URL du webhook
PAYSTACK_PLAN_PRO=            # [PUBLIC] code du plan Pro (4 900 F CFA/mois)
PAYSTACK_PLAN_BUSINESS=       # [PUBLIC] code du plan Business (9 900 F CFA/mois)

# -----------------------------------------------------------------------------
# IA — script et découpage en scènes (§10.1)
# -----------------------------------------------------------------------------
# Modèle de génération de script. Le nom du fournisseur reste à confirmer.
ANTHROPIC_API_KEY=            # [SECRET] si vous retenez Claude
# OPENAI_API_KEY=             # [SECRET] alternative éventuelle
# OPENAI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# TRANSCRIPTION des notes vocales (§10.2, étape 2)
# -----------------------------------------------------------------------------
# Choix à faire : service d'API (payant, rapide) OU modèle local (gratuit, plus lent).
TRANSCRIPTION_API_KEY=        # [SECRET] si service d'API
TRANSCRIPTION_PROVIDER=       # [PUBLIC] ex. whisper-api | local

# -----------------------------------------------------------------------------
# RENDU VIDÉO — worker (§10.1 : Remotion est auto-hébergé)
# -----------------------------------------------------------------------------
RENDER_WORKER_URL=            # [SECRET si signé] URL du worker de rendu
RENDER_WORKER_TOKEN=          # [SECRET] jeton du worker
# Rappel : licence Remotion — gratuite jusqu'à 3 personnes, sinon
# « Remotion for Automators » à 0,01 $/rendu avec un minimum de 100 $/mois.
